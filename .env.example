# Copy to .env for local development. Every value shown is the default.
# Secrets: none are required. If you add some (e.g. an API key), set them in your host's
# secret store, never in the repository.

PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Number of reverse proxies in front of the service (e.g. 1 on Render/Fly) so rate limiting
# sees the real client IP. Leave 0 when exposed directly. Never set it higher than reality.
TRUST_PROXY=0

# --- Source fetching (SSRF / resource limits) ---
FETCH_TIMEOUT_MS=10000
MAX_SOURCE_BYTES=10485760
MAX_SOURCE_PIXELS=40000000
MAX_REDIRECTS=3
ALLOWED_PORTS=80,443
# Optional comma-separated host allow-list ("example.com" also allows "*.example.com").
ALLOWED_HOSTS=
# DANGEROUS: lets the service fetch loopback/private addresses. Local development only.
ALLOW_PRIVATE_NETWORKS=false

# --- Output limits ---
MAX_OUTPUT_DIMENSION=4096
# Largest response body in bytes (0 = unlimited). Set it where the host caps response size.
MAX_OUTPUT_BYTES=0
MAX_CONCURRENT_TRANSFORMS=4
MAX_QUEUED_TRANSFORMS=16

# --- Caching ---
CACHE_TTL_SECONDS=3600
RESULT_CACHE_MB=128
SOURCE_CACHE_MB=64
SOURCE_CACHE_TTL_SECONDS=300

# --- Rate limiting (per client IP) ---
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60

# Directory of the built web UI to serve at "/" (set automatically in the Docker image).
WEB_DIST_DIR=
